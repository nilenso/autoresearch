         "--bbox", "-71.1,42.3,-71.0,42.4", "--top", "3",
     ])
     assert result.exit_code == 0, result.output
-    data = json.loads(result.output)
+    data = json.loads(result.stdout)
     assert data == [
         {"value": "restaurant", "count": 10},
